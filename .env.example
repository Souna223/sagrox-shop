# ============================================================================
# wbsite — Variáveis de ambiente (template)
# Copie para .env (local) ou configure no painel de hospedagem (produção).
# ============================================================================

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/wbsite?schema=public"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="wbsite"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js (NextAuth v5) — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Appmax (gateway de pagamento)
APPMax_PUBLIC_KEY=""
APPMax_SECRET_KEY=""
APPMax_ENVIRONMENT="sandbox"
APPMax_WEBHOOK_SECRET=""

# Cloudinary (armazenamento de imagens)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Correios (frete)
CORREIOS_CONTRACT=""
CORREIOS_PASSWORD=""

# Analytics
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_PINTEREST_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
META_ACCESS_TOKEN=""
META_PIXEL_ID=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# E-mail (transacional / marketing)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@localhost"

# IA
OPENAI_API_KEY=""

# Admin inicial (usado apenas pelo prisma/seed.ts)
ADMIN_EMAIL="admin@wbsite.com.br"
ADMIN_PASSWORD=""
